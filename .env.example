# All values are optional for local development.
# PORT=3000
# HOST=127.0.0.1
# APP_ORIGIN=http://localhost:3000
# UPLOAD_HUB_DATABASE=data/upload-hub.sqlite
# Directory for private video sources. Defaults to the media folder alongside the database.
# UPLOAD_HUB_MEDIA=data/media

# Enable live publishing with a multi-profile Ayrshare account.
# AYRSHARE_API_KEY=
# PUBLISH_SECRET=   (generate once with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))")
# PUBLIC_MEDIA_ORIGIN=https://your-public-upload-hub.example
# TIKTOK_MODE=draft
